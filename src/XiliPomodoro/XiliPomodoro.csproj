<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType><TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion><ApplicationManifest>app.manifest</ApplicationManifest>
    <RootNamespace>XiliPomodoro</RootNamespace><AssemblyName>惜立番茄钟</AssemblyName><Product>惜立番茄钟</Product><Title>惜立番茄钟</Title>
    <UseWinUI>true</UseWinUI><WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained><SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier><PlatformTarget>x64</PlatformTarget>
    <WindowsAppSDKDeploymentManagerInitialize>false</WindowsAppSDKDeploymentManagerInitialize>
    <WindowsAppSDKBootstrapInitialize>false</WindowsAppSDKBootstrapInitialize>
    <ApplicationIcon>Assets\XiliPomodoro.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup Condition="'$(EnableUiTests)' == 'true'">
    <Compile Include="..\..\tests\UiHarness\*.cs" Link="Diagnostics\%(Filename)%(Extension)" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.8.260804001" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.5" />
    <PackageReference Include="SQLitePCLRaw.lib.e_sqlite3" Version="3.53.3" />
    <PackageReference Include="Microsoft.Graphics.Win2D" Version="1.4.0" />
    <ProjectReference Include="..\XiliPomodoro.Core\XiliPomodoro.Core.csproj" />
    <Content Include="Assets\XiliPomodoro.ico" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\TaskIllustration.png" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <!-- CLI publishing can omit WinUI's generated XAML and PRI resources.
       Keep them beside the executable, just as in the verified build output. -->
  <Target Name="CopyWinUIResourcesToPublish" AfterTargets="Publish">
    <Error Condition="!Exists('$(TargetDir)App.xbf') Or !Exists('$(TargetDir)$(AssemblyName).pri')" Text="WinUI XAML resources are missing from the build output." />
    <ItemGroup><_XiliPomodoroXamlResource Include="$(TargetDir)App.xbf;$(TargetDir)$(AssemblyName).pri" /></ItemGroup>
    <Copy SourceFiles="@(_XiliPomodoroXamlResource)" DestinationFolder="$(PublishDir)" SkipUnchangedFiles="true" />
  </Target>
</Project>
